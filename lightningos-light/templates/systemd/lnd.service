[Unit]
Description=Lightning Network Daemon (LND)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/lnd --lnddir=/home/lnd/.lnd
ExecStop=/usr/local/bin/lncli stop

# LND mkdirs its data tree with mode 0700 regardless of UMask, so the
# lightningos-manager (which runs as `lightningos`, a member of the `lnd`
# group) cannot traverse to read macaroons. Reapply 0750 on every start
# so the group-read perm survives chain switches and wipe/reinit events.
# Errors are swallowed: if /data/lnd/data doesn't exist yet (fresh
# install before first unlock), nothing to do.
ExecStartPost=/bin/sh -c 'find /data/lnd/data -type d -exec chmod 0750 {} + 2>/dev/null || true'

# Process management
Restart=on-failure
RestartSec=60
Type=notify
TimeoutStartSec=1200
TimeoutStopSec=3600

# Runtime directory
RuntimeDirectory=lightningd
RuntimeDirectoryMode=0710
User=lnd
Group=lnd
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
MemoryDenyWriteExecute=true
ProtectSystem=full


[Install]
WantedBy=multi-user.target
